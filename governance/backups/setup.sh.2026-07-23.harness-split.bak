#!/usr/bin/env bash
# setup.sh — 安裝三個 harness 的全域薄入口與單層 skill link farms。

set -euo pipefail

REPOSITORY_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INSTALL_HOME="${AGENT_SKILL_HOME:-$HOME}"
CLAUDE_SKILLS_ROOT="$INSTALL_HOME/.claude/skills"
CODEX_SKILLS_ROOT="$INSTALL_HOME/.codex/skills"
SKILL_NAMES=()
SKILL_TARGETS=()

while IFS=$'\t' read -r skill_name skill_path; do
  SKILL_NAMES+=("$skill_name")
  SKILL_TARGETS+=("$REPOSITORY_DIR/$skill_path")
done < <(python3 - "$REPOSITORY_DIR/skills/index.json" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as index_file:
    for skill in json.load(index_file)["skills"]:
        print(f"{skill['name']}\t{skill['path'].removesuffix('/SKILL.md')}")
PY
)

preflight_skills_root() {
  local skills_root="$1"
  local index
  if [[ -L "$skills_root" ]]; then
    if [[ "$(readlink "$skills_root")" != "$REPOSITORY_DIR/skills" ]]; then
      echo "⚠️  $skills_root 是非本系統 symlink；未修改。" >&2
      return 1
    fi
    return
  fi
  if [[ -e "$skills_root" && ! -d "$skills_root" ]]; then
    echo "⚠️  $skills_root 不是目錄；未修改。" >&2
    return 1
  fi
  for ((index=0; index<${#SKILL_NAMES[@]}; index++)); do
    local entry="$skills_root/${SKILL_NAMES[$index]}"
    local expected="${SKILL_TARGETS[$index]}"
    if [[ -e "$entry" || -L "$entry" ]]; then
      if [[ ! -L "$entry" || "$(readlink "$entry")" != "$expected" ]]; then
        echo "⚠️  skill entry 衝突：${entry}；未進行任何安裝。" >&2
        return 1
      fi
    fi
  done
}

preflight_file_link() {
  local target_path="$1"
  local expected_source="$2"
  if [[ -e "$target_path" || -L "$target_path" ]]; then
    if [[ ! -L "$target_path" || "$(readlink "$target_path")" != "$expected_source" ]]; then
      echo "⚠️  $target_path 已被其他內容占用；未進行任何安裝。" >&2
      return 1
    fi
  fi
}

install_skills_root() {
  local skills_root="$1"
  local index
  if [[ -L "$skills_root" ]]; then
    rm "$skills_root"
  fi
  mkdir -p "$skills_root"
  for ((index=0; index<${#SKILL_NAMES[@]}; index++)); do
    ln -sfn "${SKILL_TARGETS[$index]}" "$skills_root/${SKILL_NAMES[$index]}"
  done
}

install_file_link() {
  local source_path="$1"
  local target_path="$2"
  mkdir -p "$(dirname "$target_path")"
  ln -sfn "$source_path" "$target_path"
}

python3 "$REPOSITORY_DIR/bin/validate-skill-index.py" --repo "$REPOSITORY_DIR"
preflight_skills_root "$CLAUDE_SKILLS_ROOT"
preflight_skills_root "$CODEX_SKILLS_ROOT"
preflight_file_link "$INSTALL_HOME/.claude/governance" "$REPOSITORY_DIR/governance"
preflight_file_link "$INSTALL_HOME/.claude/CLAUDE.md" "$REPOSITORY_DIR/CLAUDE.global.md"
preflight_file_link "$INSTALL_HOME/.codex/AGENTS.md" "$REPOSITORY_DIR/AGENTS.md"
preflight_file_link "$INSTALL_HOME/.gemini/GEMINI.md" "$REPOSITORY_DIR/GEMINI.md"

install_skills_root "$CLAUDE_SKILLS_ROOT"
install_skills_root "$CODEX_SKILLS_ROOT"
install_file_link "$REPOSITORY_DIR/governance" "$INSTALL_HOME/.claude/governance"
install_file_link "$REPOSITORY_DIR/CLAUDE.global.md" "$INSTALL_HOME/.claude/CLAUDE.md"
install_file_link "$REPOSITORY_DIR/AGENTS.md" "$INSTALL_HOME/.codex/AGENTS.md"
install_file_link "$REPOSITORY_DIR/GEMINI.md" "$INSTALL_HOME/.gemini/GEMINI.md"

python3 "$REPOSITORY_DIR/bin/validate-skill-index.py" \
  --repo "$REPOSITORY_DIR" \
  --claude-adapter "$CLAUDE_SKILLS_ROOT" \
  --codex-adapter "$CODEX_SKILLS_ROOT"
echo "🎉 Setup 完成：Claude/Codex 單層 adapters 已連到分類正本。"
